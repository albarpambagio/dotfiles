#!/usr/bin/env bash
# Per-monitor workspace switcher.
# Maps SUPER+1-0 to the focused monitor's own block of ten workspaces, as
# assigned by Omarchy in ~/.local/state/omarchy/monitor-workspaces.
# Usage: omarchy-workspace-switch <number>
#        omarchy-workspace-switch move <number>
#        omarchy-workspace-switch silent <number>

set -euo pipefail

MODE=focus
case "${1:-}" in
  move)   MODE=move;   shift ;;
  silent) MODE=silent; shift ;;
esac

WS_NUM="${1:?Usage: $0 [move|silent] <workspace-number>}"

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/monitor-workspaces"

# Detect focused monitor
FOCUSED=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')

# The state file is tab separated: block <TAB> connector <TAB> identity.
# Omarchy gives every monitor a block of ten workspaces (laptop panel first).
BLOCK=""
if [ -r "$STATE_FILE" ]; then
  BLOCK=$(awk -F'\t' -v c="$FOCUSED" '$2 == c { print $1; exit }' "$STATE_FILE")
fi

if [ -z "$BLOCK" ]; then
  # Never guess: silently routing to another block would put the window on the
  # wrong monitor. A missing entry means Omarchy has not assigned this monitor
  # yet (see ~/.local/state/omarchy/monitor-workspaces).
  MSG="omarchy-workspace-switch: no workspace block for monitor '$FOCUSED' in $STATE_FILE"
  command -v notify-send >/dev/null && notify-send -u critical -a "Workspace switcher" "$MSG" || true
  echo "$MSG" >&2
  exit 1
fi

TARGET=$((WS_NUM + BLOCK * 10))

case "$MODE" in
  focus)  hyprctl dispatch "hl.dsp.focus({workspace='${TARGET}'})" ;;
  move)   hyprctl dispatch "hl.dsp.window.move({workspace='${TARGET}', follow=true})" ;;
  silent) hyprctl dispatch "hl.dsp.window.move({workspace='${TARGET}', follow=false})" ;;
esac
