[Unit]
Description=Laptop speaker EQ filter-chain
After=pipewire.service wireplumber.service
Requires=pipewire.service
Wants=wireplumber.service
PartOf=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/pipewire -c /home/albar/.config/pipewire/speaker-eq.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
